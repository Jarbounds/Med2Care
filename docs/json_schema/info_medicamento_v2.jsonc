// Based on medicine information from https://www.medicines.org.uk/emc/browse-medicines
{
	"medicine_id": "ATC code",
	"metadata": {
		"name": "<medicine name>",
		"composition": "<active principle with amount>",
		"clinical_particulars": {
			"therapeutic_indications": "<therapeutic indications for usage>",
			"contraindications": {
				"disease": [
					{
						"name": "<disease name>",
						"description": "<description of disease interaction>"
					}
				],
				/*"fertility_pregnancy_lactation": [
					{
						"name": "<Fertility | Pregnancy | Lactation>",
						"description": "<interaction description for given condition>"
					}
				],*/
				"pregnancy": "<interaction description for given condition>",
				"machine_ops": "<description for driving and operating machines under medicine effect>",
				"excipients": "<semicollon separated excipients present in medicine>",
				"incompatibilities": "<semicollon separated medicine names that are imcompatible with this medicine>"
			}
		},
		"revision_date": "<revision date with format yyyy-mm-dd>"
	}
}
