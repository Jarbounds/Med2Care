			},*/
			// Ponto 4.2 indica como deve ser tomado o medicamento e as dosagens apropriadas para cada tipo de população indicado.
			/*"posology_method_administration": {
				// Talvez separar em campos separados caso seja semelhante a estruturação.
				"general_conditions": "Pode ser tomado com ou sem comida, não deve ser mastigado, etc.",
				// Uma entrada para cada tipo de população (se for o caso se ser geral apenas terá uma entrada)
