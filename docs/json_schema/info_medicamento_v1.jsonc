		// Ponto 1.
		"name": "Medicamento 1",
		// Ponto 2.
		"composition": "Contém x mg de y de princício ativo",
		// Ponto 3 indica a forma dos comprimidos e pode ter a indicação sobre a subdivisão desse comprimido (ver se é relevante)
		// "form": "",
		// Ponto 4 representa a informação clínica.
		"clinical_particulars": {
			// Ponto 4.1 indica para tratamento o medicamento é usado e também algumas informações iniciais sobre pré condições em que pode (ou não) ser aplicado.
			"terapeutical_indications": "",/*{
				"treating_diseases": "doença x, doença y, etc.",
