			// TODO: Aglomerar os campos de contraindicações.
			"contraindications": {
				"disease": [
					{
						"name": "Doença X",
						"description": "Foram relatados casos da doença X mas não foi encontrada relação"
					}
				],
				"excipients": "Separado por vírgula,Hipersensibilidade a algum dos componentes",
				"incompatibilies": "Separado por vírgula,"
			},
